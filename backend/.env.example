# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_management

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- AI Chatbot (opsional) ---
# Kosongkan OPENAI_API_KEY jika ingin memakai mode rule-based (tanpa API key, tetap berfungsi).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
